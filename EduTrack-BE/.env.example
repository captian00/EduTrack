PORT=3001
NODE_ENV=development
# Runtime nên dùng Supabase transaction pooler (port 6543) trên Vercel.
DATABASE_URL=postgresql://postgres.project-ref:password@region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require
# Chỉ dùng direct/session connection cho Prisma migrations.
DIRECT_URL=postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres?sslmode=require
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CORS_ORIGIN=http://localhost:3000
CRON_SECRET=replace-with-at-least-16-random-characters
VIETQR_API_BASE_URL=
VIETQR_CLIENT_ID=
VIETQR_API_KEY=
